---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-white min-h-screen flex flex-col items-center py-12 sm:py-20">
    <button
      id="print-button"
      class="fixed top-4 right-4 bg-black text-white px-4 py-2 rounded-md shadow-lg print:hidden
             hover:bg-gray-800 transition-colors duration-200 z-50"
      onclick="window.print()"
    >
      Print to PDF
    </button>

    <main class="w-full max-w-4xl px-6 sm:px-12 md:px-16 bg-white">
      <slot />
    </main>
  </body>
</html>
