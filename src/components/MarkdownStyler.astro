---
interface Props {
  removeParagraphSpacing?: boolean;
}

const { removeParagraphSpacing = false } = Astro.props;

const paragraphMarginClass = removeParagraphSpacing
  ? "prose-p:mb-0"
  : "prose-p:mb-4";
---

<div
  class={`prose prose-neutral max-w-none 
            prose-headings:font-bold prose-headings:text-black prose-headings:uppercase prose-headings:tracking-tight
            prose-h2:text-lg prose-h2:mt-6 prose-h2:mb-2 prose-h2:border-b prose-h2:border-black prose-h2:pb-1
            prose-p:text-justify prose-p:text-gray-800 prose-p:leading-normal ${paragraphMarginClass}
            prose-a:text-black prose-a:underline prose-a:decoration-1 prose-a:underline-offset-2 hover:prose-a:decoration-2
            prose-li:marker:text-black
            prose-strong:font-bold prose-strong:text-black`}
>
  <slot />
</div>
