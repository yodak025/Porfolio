---
interface Props {
  title: string;
  class?: string; // Opcional para clases extra en el contenedor section
}

const { title, class: className = "" } = Astro.props;
---

<section class:list={["mb-8 break-inside-avoid", className]}>
  <!-- Título de sección: Espaciado inferior reducido de mb-6 a mb-4 -->
  <h3 class="text-sm font-bold uppercase tracking-widest mb-4 text-gray-400">
    {title}
  </h3>
  
  <!-- El contenido (MarkdownStyler, columnas, etc.) va aquí -->
  <slot />
</section>
