---
import BaseSection from "../BaseSection.astro";
import MarkdownStyler from "../MarkdownStyler.astro";

import * as EducationData from "../../../cv/education.md";

const { title, visible } = EducationData.frontmatter;
const Content = EducationData.Content;

if (!visible) return;
---

<BaseSection title={title}>
  <MarkdownStyler removeParagraphSpacing={true}>
    <Content />
  </MarkdownStyler>
</BaseSection>
