---
import BaseSection from "../BaseSection.astro";
import MarkdownStyler from "../MarkdownStyler.astro";

import * as LanguagesData from "../../../cv/languages.md";

const { title, visible } = LanguagesData.frontmatter;
const Content = LanguagesData.Content;

if (!visible) return;
---

<BaseSection title={title}>
  <MarkdownStyler>
    <Content />
  </MarkdownStyler>
</BaseSection>
