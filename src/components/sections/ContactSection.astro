---
// Receives the Frontmatter of the contactInfo.md file
interface Props {
  frontmatter: {
    name: string;
    role: string;
    email: string;
    phone: string;
    location: string;
    linkedin?: string;
    github?: string;
    web?: string;
  };
}

const { frontmatter } = Astro.props;
---

<header class="mb-10 border-b-4 border-black pb-6">
  <h1
    class="text-5xl md:text-7xl font-bold tracking-tighter uppercase mb-2 leading-none"
  >
    {frontmatter.name}
  </h1>
  <p class="text-xl md:text-2xl font-medium tracking-wide mb-6 text-gray-600">
    {frontmatter.role}
  </p>

  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-y-2 gap-x-8 text-sm font-mono uppercase tracking-wider"
  >
    <div class="flex flex-col gap-1">
      <a
        href={`mailto:${frontmatter.email}`}
        class="hover:bg-black hover:text-white transition-colors w-fit px-1 -ml-1"
      >
        {frontmatter.email}
      </a>
      <span>{frontmatter.phone}</span>
      <span>{frontmatter.location}</span>
    </div>

    <div class="flex flex-col gap-1 md:text-right">
      {
        frontmatter.linkedin && (
          <a
            href={frontmatter.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:bg-black hover:text-white transition-colors w-fit md:ml-auto px-1 -mr-1"
          >
            LinkedIn
          </a>
        )
      }
      {
        frontmatter.github && (
          <a
            href={frontmatter.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:bg-black hover:text-white transition-colors w-fit md:ml-auto px-1 -mr-1"
          >
            GitHub
          </a>
        )
      }
      {
        frontmatter.web && (
          <a
            href={frontmatter.web}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:bg-black hover:text-white transition-colors w-fit md:ml-auto px-1 -mr-1"
          >
            Portfolio
          </a>
        )
      }
    </div>
  </div>
</header>
