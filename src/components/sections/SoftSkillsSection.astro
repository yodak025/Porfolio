---
import BaseSection from "../BaseSection.astro";
import MarkdownStyler from "../MarkdownStyler.astro";

import * as SoftSkillsData from "../../../cv/softSkills.md";

const { title, visible } = SoftSkillsData.frontmatter;
const Content = SoftSkillsData.Content;

if (!visible) return;
---

<BaseSection title={title}>
  <!-- Sin columnas internas, lista vertical simple -->
  <MarkdownStyler>
    <Content />
  </MarkdownStyler>
</BaseSection>
